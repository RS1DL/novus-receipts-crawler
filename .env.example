# Copy to .env and fill in. .env is gitignored — never commit real tokens.

# Required: starting access token (external input; OTP login is out of scope).
NOVUS_USER_TOKEN=

# Optional: enables reactive refresh when the access token expires.
NOVUS_REFRESH_TOKEN=

# Optional overrides (defaults shown).
# NOVUS_BASE_URL=https://api.novus.online
# NOVUS_PRIVATE_KEY=070696aa5d8844e3c71e90604a7b0a11dc0c99638d3f2e0bf53c2f091ac52d4c
# NOVUS_PLATFORM_VERSION=14 (34)
# NOVUS_TIMEOUT_S=30
# NOVUS_MAX_RETRIES=3
# NOVUS_BACKOFF_BASE_S=1.0
# NOVUS_REQUEST_DELAY_S=0.2
# NOVUS_DETAIL_CONCURRENCY=1
