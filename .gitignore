# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtualenv / uv
.venv/
venv/

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — never commit real tokens
.env

# Collected output (personal data) — keep out of git (tests/fixtures/*.json stay tracked)
/*.json

# SQLite store written by `python -m novus_receipts.collect` (+ its WAL sidecars)
/*.db
/*.db-wal
/*.db-shm

# Sidecar crawl-error log (operational data)
/*.errors.jsonl

# Editor / OS
.idea/
.vscode/
.DS_Store
